# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tcg_db
DATABASE_USER=tcg_user
DATABASE_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development

# Admin — el usuario que se registre con este email será admin automáticamente
ADMIN_EMAIL=

# Mercado Pago (https://www.mercadopago.com.mx/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=   # Opcional: activa verificación de firma en el webhook

# Backend public URL (necesario para que MP pueda llamar el webhook)
BACKEND_URL=https://your-backend.up.railway.app

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=tcg_live

# LiveKit (https://cloud.livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Web URL (for Mercado Pago redirect callbacks)
WEB_URL=https://your-web-domain.com
