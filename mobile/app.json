{
  "expo": {
    "name": "TCG Live",
    "slug": "tcg-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tcglive.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Se necesita la cámara para hacer streaming de subastas en vivo.",
        "NSMicrophoneUsageDescription": "Se necesita el micrófono para el audio de las subastas en vivo."
      }
    },
    "android": {
      "package": "com.tcglive.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C3AE8",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se necesita acceso a tus fotos para agregar imágenes de las cartas.",
          "cameraPermission": "Se necesita la cámara para tomar fotos de las cartas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8cbee7d6-d5ea-4124-a7dc-58f7b45d63a3"
      }
    }
  }
}
