# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_* variables are bundled into the app at build time (safe for non-secret config).
# Do NOT put secret keys here — use EAS Secrets for those.

# API base URL (no trailing slash, no /api suffix).
# Local Android emulator default:
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Production example:
# EXPO_PUBLIC_API_URL=https://api.tcglive.mx
